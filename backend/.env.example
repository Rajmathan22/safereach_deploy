# SafeReach PHP Backend Environment Template
# Copy this file to backend/.env and update credentials as needed.

SAFE_REACH_ENV=development
PORT=5000
SECRET_KEY=safereach-super-secret-key-2026
JWT_SECRET=safereach-jwt-secret-key-2026
JWT_ACCESS_MINUTES=30
JWT_REFRESH_DAYS=14

# Database Configuration (MySQL 8.0)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=safereach_db
DB_USERNAME=root
DB_PASSWORD=rootpassword

# Seed Passwords (for database/seed.php)
SEED_MAIN_ADMIN_PASSWORD=MainAdmin@2025
SEED_ADMIN_PASSWORD=Admin@2025
SEED_TEACHER_PASSWORD=Teacher@2025
SEED_PARENT_PASSWORD=Parent@2025

# Frontend CORS Origins
FRONTEND_ORIGIN=http://localhost:3000
FRONTEND_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Twilio SMS (Set SMS_TEST_MODE=false with valid credentials for live SMS)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_PHONE=
TWILIO_TEST_TO_PHONE=+910000000000
SMS_TEST_MODE=true

# Resend Email (Optional)
RESEND_API_KEY=
RESEND_FROM_EMAIL=SafeReach <noreply@safereach.local>
