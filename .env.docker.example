# =================================================================
# SafeReach - Docker Deployment Environment Configuration
# Copy this file to .env on your server: cp .env.docker.example .env
# =================================================================

# Environment Mode
SAFE_REACH_ENV=production

# Security Keys (Generate strong random secrets for production)
SECRET_KEY=safereach-super-secret-key-prod-2026
JWT_SECRET=safereach-jwt-secret-key-prod-2026

# MySQL Database Credentials
DB_ROOT_PASSWORD=rootpassword
DB_DATABASE=safereach_db
DB_USERNAME=safereach_user
DB_PASSWORD=safereach_password

# Twilio SMS Configuration (Optional)
# Set SMS_TEST_MODE=false with valid credentials to send real SMS
SMS_TEST_MODE=true
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_PHONE=
TWILIO_TEST_TO_PHONE=+910000000000

# Resend Email Configuration (Optional)
RESEND_API_KEY=
RESEND_FROM_EMAIL=SafeReach <noreply@safereach.local>
